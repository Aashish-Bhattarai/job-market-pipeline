# Copy to .env (gitignored) and fill in only the keys for sources you use.
# discover/sources/_settings.py reads `<SOURCE>_API_KEY` env vars in preference
# to config.yaml's `sources:` block, so a real key never has to be written into
# the tracked config.yaml. Missing/empty keys just skip that source -- the
# batch never crashes on them.
#
# Nothing in this repo auto-loads .env -- export these yourself (e.g.
# `set -a; source .env; set +a` on POSIX shells, or your process manager's
# env-file support) before running python/node.
REED_API_KEY=
